{
  "manifest_version": 3,
  "name": "BlinkFill",
  "version": "0.3.0",
  "description": "まばたきする間にフォームを埋める。登録した個人情報や貼り付けた内容を一括入力し、送信ボタンは押さない。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "action": {
    "default_title": "BlinkFill（Alt+J）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      }
    },
    "fill-profile": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "個人情報をワンクリック入力"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "BlinkFill"
}
