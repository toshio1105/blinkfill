{
  "manifest_version": 3,
  "name": "BlinkFill - フォーム自動入力ツール",
  "version": "0.3.2",
  "description": "個人情報のワンクリック入力、貼り付けた内容の一括入力、よく使う画面の入力先を記憶して、フォーム入力を一瞬で完了",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "action": {
    "default_title": "BlinkFill（Alt+J）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      }
    },
    "fill-profile": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "個人情報をワンクリック入力"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "BlinkFill"
}
